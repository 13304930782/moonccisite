# Merge inside the EXISTING HTTPS server; replace @WEB_ROOT@ with nginx -T's
# confirmed static root. Do not replace the vhost or its security headers.
location = /.well-known/autoconfig/mail/config-v1.1.xml {
    alias @WEB_ROOT@/mail/config-v1.1.xml;
    types { } default_type application/xml;
    access_log off; error_log /dev/null emerg; log_not_found off;
    error_page 404 = @mooncci_mail_missing;
}
location = /mail/config-v1.1.xml {
    alias @WEB_ROOT@/mail/config-v1.1.xml;
    types { } default_type application/xml;
    access_log off; error_log /dev/null emerg; log_not_found off;
    error_page 404 = @mooncci_mail_missing;
}
location @mooncci_mail_missing {
    access_log off; error_log /dev/null emerg;
    return 404;
}
# Only needed for personalized Apple downloads. Existing /api security stays on.
location ^~ /api/mail-setup/ {
    access_log off; error_log /dev/null emerg;
    client_max_body_size 512;
    client_body_buffer_size 1k;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    proxy_intercept_errors off;
    proxy_next_upstream off;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_pass http://127.0.0.1:3001;
}
