[Unit]
Description=mooncci isolated public reader
After=network-online.target
[Service]
Type=simple
User=mooncci-reader
Group=mooncci-reader
WorkingDirectory=/opt/mooncci-reader/current
EnvironmentFile=/etc/mooncci-reader.env
ExecStart=/www/server/nodejs/v22.23.1/bin/node --max-old-space-size=128 /opt/mooncci-reader/current/edge/reader/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M
TasksMax=64
CPUQuota=50%
[Install]
WantedBy=multi-user.target
