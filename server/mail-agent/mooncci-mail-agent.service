[Unit]
Description=mooncci outbound mailbox provisioning agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/mooncci-mail-agent.env
ExecStart=/www/server/panel/pyenv/bin/python3 /opt/mooncci-mail-agent/agent.py
WorkingDirectory=/www/server/panel
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
