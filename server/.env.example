# mooncci server environment example.
# Copy this file to .env and fill real values on the server.
# Never commit or package real secrets.

NODE_ENV=production
PORT=3001
SITE_URL=https://mooncci.site

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_CONNECTION_LIMIT=20

JWT_SECRET=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=614401761904-4g7soo2d1clsnui71h5tb9ia4j1t530m.apps.googleusercontent.com
GOOGLE_CERTS_URL=https://google-certs.mooncci.site/google-certs

COOKIE_SECURE=true
COOKIE_DOMAIN=.mooncci.site
CORS_ORIGINS=https://mooncci.site,https://www.mooncci.site

MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
COMMENT_NOTIFY_TO=
EARLY_ACCESS_DOWNLOAD_URL=https://downloads.example.com/PromptDock.dmg
EARLY_ACCESS_UPLOAD_MAX_MB=512

CUSTOM_MAIL_DAILY_LIMIT=20

# Electricity Monitor. Keep both credential values server-side only.
ELECTRICITY_ENABLED=true
ELECTRICITY_SCHOOL_ACCOUNT=
ELECTRICITY_ROOM_VERIFY=
ELECTRICITY_CUSTOMER_CODE=2252
ELECTRICITY_COMMAND=OWNWaterElecService
ELECTRICITY_DAILY_NOTIFY=true
ELECTRICITY_NOTIFY_HOUR=21
ELECTRICITY_SCHEDULE_HOURS=0,7,12,21
ELECTRICITY_MANUAL_COOLDOWN_MINUTES=15
ELECTRICITY_LOW_PURCHASE_THRESHOLD=10
ELECTRICITY_LOW_TOTAL_THRESHOLD=20

# Content platform: opt-in background tasks
GITHUB_SYNC_ENABLED=false
GITHUB_TOKEN=
NEWSLETTER_DELIVERY_ENABLED=false

# New content connections use UTC; legacy posts default to the Node process timezone.
# Set only if legacy posts were written in a different timezone (China = 480, UTC = 0).
# POSTS_STORAGE_UTC_OFFSET_MINUTES=480
CONTENT_DB_CONNECTION_LIMIT=5

# Private electricity RSS reuses SITE_URL and JWT_SECRET (no extra mail or schedule switch).
# Set SITE_URL to the public HTTPS origin. Rotating JWT_SECRET requires resetting RSS links.
# Changing electricity account/room/customer scopes reports and invalidates old RSS links.

# Optional: only set after verifying an actual cumulative meter reading field (kWh).
# Format: record.<field> or body.<field>. Never map todayuse, odd, or sumuse.
ELECTRICITY_CUMULATIVE_READING_FIELD=

# Weather companion: mainland forecast uses the existing Amap Web Service Key; other regions use Open-Meteo.
# Set false to hide the companion. Manual moods are managed under Site Settings.
MOONCCI_WEATHER_BOT_ENABLED=true

# Optional Nominatim-compatible reverse geocoding endpoint (default needs no API key).
# MOONCCI_REVERSE_GEOCODING_URL=https://nominatim.openstreetmap.org/reverse

# Mainland city identification/search (server-side Web Service Key only).
# MOONCCI_CITY_PROVIDER=amap
# AMAP_WEB_SERVICE_KEY=

# Weather companion v9: signed visitor identity reuses JWT_SECRET.
# Daily/monthly upstream budgets are persisted in site_settings; defaults live in src/lib/weatherBudget.js.
# Amap weather: 140/day, 4500/month. Amap LBS: 3500/day, 120000/month.

# 多宿舍学校查询凭据的服务端加密密钥（32 字节十六进制，严禁放进 VITE_*）。
# 部署脚本首次自动生成；后续保留并与数据库一同备份，不能随意修改。
ELECTRICITY_CREDENTIAL_KEY=
HOST=127.0.0.1
# Nginx runs on the same machine. Set explicit trusted proxy IPs for other topologies.
TRUST_PROXY=loopback

# Third-party login secrets are managed in /admin/login-settings (owner only).
# Optional dedicated encryption key: set BEFORE saving provider secrets.
# If absent, a domain-separated key is derived from the existing JWT_SECRET.
# Preserve the selected key with backups; changing it requires re-entering provider secrets.
OAUTH_ENCRYPTION_KEY=
# Existing GOOGLE_CLIENT_ID / GOOGLE_CERTS_URL and the CF certificate proxy are preserved.
