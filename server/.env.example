# Mooncci server environment example.
# Copy this file to .env and fill real values on the server.
# Never commit or package real secrets.

NODE_ENV=production
PORT=3001
SITE_URL=https://mooncci.site

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_CONNECTION_LIMIT=20

JWT_SECRET=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=614401761904-4g7soo2d1clsnui71h5tb9ia4j1t530m.apps.googleusercontent.com
GOOGLE_CERTS_URL=https://google-certs.mooncci.site/google-certs

COOKIE_SECURE=true
COOKIE_DOMAIN=.mooncci.site
CORS_ORIGINS=https://mooncci.site,https://www.mooncci.site

MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
COMMENT_NOTIFY_TO=
EARLY_ACCESS_DOWNLOAD_URL=https://downloads.example.com/PromptDock.dmg
EARLY_ACCESS_UPLOAD_MAX_MB=512

CUSTOM_MAIL_DAILY_LIMIT=20

# Electricity Monitor. Keep both credential values server-side only.
ELECTRICITY_ENABLED=true
ELECTRICITY_SCHOOL_ACCOUNT=
ELECTRICITY_ROOM_VERIFY=
ELECTRICITY_CUSTOMER_CODE=2252
ELECTRICITY_COMMAND=OWNWaterElecService
ELECTRICITY_DAILY_NOTIFY=true
ELECTRICITY_NOTIFY_HOUR=21
ELECTRICITY_SCHEDULE_HOURS=7,12,21
ELECTRICITY_MANUAL_COOLDOWN_MINUTES=15
ELECTRICITY_LOW_PURCHASE_THRESHOLD=10
ELECTRICITY_LOW_TOTAL_THRESHOLD=20
