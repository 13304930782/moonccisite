[Unit]
Description=Submit changed mooncci public URLs to IndexNow
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/mooncci-indexnow/indexnow.py run
TimeoutStartSec=240
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mooncci-indexnow /var/lib/mooncci-indexnow-admin
ProtectHome=true
PrivateTmp=true
